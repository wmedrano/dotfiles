# -*- mode: sh -*-
#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='\[\e[34m\]\w\[\e[0m\]\n\[\e[35m\]❯\[\e[0m\] '

# Add ~/.local/bin to PATH
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Add depot_tools to PATH when installed
if [[ -d "/home/wmedrano/src/chromium/src/third_party/depot_tools" ]]; then
    case ":$PATH:" in
        *":/home/wmedrano/src/chromium/src/third_party/depot_tools:"*) ;;
        *) export PATH="/home/wmedrano/src/chromium/src/third_party/depot_tools:$PATH" ;;
    esac
fi
